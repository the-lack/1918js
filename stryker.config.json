{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "tsconfigFile": "tsconfig.stryker-absent.json",
  "testRunner": "command",
  "ignorePatterns": [".git", "bun.lock", "LICENSE", "README.md", "documentation", ".gitignore", "tsdown.config.ts"],
  "commandRunner": {
    "command": "bun test --concurrent --max-concurrency=4 --parallel"
  },
  "concurrency": 3,
  "incremental": true,
  "incrementalFile": "cache/stryker-mutation-test-file-cache-for-incremental-testing.json",
  "mutate": ["**/!(*.+(s|S)pec|*.+(t|T)est).+(ts)"],
  "coverageAnalysis": "off",
  "disableTypeChecks": true,
  "reporters": ["clear-text"],
  "inPlace": false,
  "logLevel": "off",
  "maxTestRunnerReuse": 1,
  "allowConsoleColors": true,
  "cleanTempDir": false
}
